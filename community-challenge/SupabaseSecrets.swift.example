// Template for the git-ignored credentials file.
//
// Copy this to:
//     community-challenge/community-challenge/Service/SupabaseSecrets.swift
// and fill in the values, then the app target will compile.
//
// Get the values from Supabase Dashboard → Project Settings → API, or:
//     supabase projects api-keys --project-ref <your-project-ref>
//
// Use the anon / publishable key ONLY. The service_role and secret keys bypass
// Row Level Security and must never be shipped in a client binary.
//
// This file has a .example extension so Xcode does not compile it; the real
// file lives inside the synchronized target folder and is picked up
// automatically once created.

import Foundation

enum SupabaseSecrets {
    static let projectURL = URL(string: "https://YOUR-PROJECT-REF.supabase.co")!
    static let anonKey = "YOUR-ANON-KEY"
}
