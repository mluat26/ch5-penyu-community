// Copy this file to SupabaseSecrets.xcconfig and fill in local values.
// Never put a Supabase service_role or secret key in an iOS app.
// Supply only the hostname; Info.plist safely adds https:// at build time.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = sb_publishable_your_key_here
